# Copy to `.env` and fill in real values. All keys are exposed to the client
# (Vite inlines VITE_* at build time) — same trust model as the old Flutter
# --dart-define values, which were also shipped in the web bundle.
# REST calls go through a same-origin proxy to avoid browser CORS:
#   - dev:  vite.config.ts `server.proxy`
#   - prod: vercel.json `rewrites` (/api/* -> your REST API)
# Set the real REST host in THOSE two files, and keep this as /api.
VITE_API_BASE_URL=/api
VITE_WEBSOCKET_URL=wss://YOUR_WS_API_ID.execute-api.us-east-1.amazonaws.com/prod
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
VITE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
